@startuml
title Components

left to right direction
skinparam componentStyle rectangle

component Main

package "cli" {
  component ConsoleApplication
}

package "application" {
  component LinkService
  component ExpiredLinkCleaner
  component ApplicationConfig
  interface Storage
  interface ShortCodeGenerator
}

package "domain" {
  component ShortLink
}

package "infrastructure" {
  component LocalFileStorage
  component CodeGenerator
  component PropertiesConfigLoader
}

Main --> ConsoleApplication
ConsoleApplication --> LinkService
ConsoleApplication --> ExpiredLinkCleaner

LinkService --> ShortLink
LinkService --> Storage
LinkService --> ShortCodeGenerator
LinkService --> ApplicationConfig
ExpiredLinkCleaner --> Storage

LocalFileStorage ..|> Storage
CodeGenerator ..|> ShortCodeGenerator
PropertiesConfigLoader --> ApplicationConfig

@enduml
